; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

input_prompts/icons/keyboard="uid://domrawueas2s"
input_prompts/icons/mouse_buttons="uid://bt25mebuyicjf"
input_prompts/icons/joypad_buttons/nintendo="uid://b6c8pokb8gcw7"
input_prompts/icons/joypad_buttons/sony="uid://0xc6pdew3ihn"
input_prompts/icons/joypad_buttons/xbox="uid://dyji5vfuvoxpk"
input_prompts/icons/joypad_motion/nintendo="uid://du54xrg6060as"
input_prompts/icons/joypad_motion/sony="uid://bcfyuk0xhldj1"
input_prompts/icons/joypad_motion/xbox="uid://dkjlrandqglyj"
imgui/config="uid://cymx5hoexxule"

[application]

config/name="Barrel"
run/main_scene="uid://bus7tc0ndedol"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

PromptManager="*res://addons/input_prompts/input_prompt_manager.gd"
UIAnimation="*res://addons/godot_ui_animations/UIAnimationHandler.tscn"
ImGuiRoot="*res://addons/imgui-godot/data/ImGuiRoot.tscn"
BarrelDebugWindow="*res://Scripts/Tools/ImGui Debug/BarrelGlobalDebugWindow.gd"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/unused_signal=0
shader_language/warnings/unused_function=false

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Barrel"

[editor_plugins]

enabled=PackedStringArray("res://addons/LineRenderer/plugin.cfg", "res://addons/godot_ui_animations/plugin.cfg", "res://addons/imgui-godot/plugin.cfg", "res://addons/input_prompts/plugin.cfg", "res://addons/sky_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://Animations/": "orange",
"res://DEBUG/": "gray",
"res://Data/": "yellow",
"res://Materials/": "green",
"res://Meshes/": "teal",
"res://Scenes/": "purple",
"res://Scripts/": "pink",
"res://Textures/": "gray",
"res://addons/": "red"
}

